# =============================================================================
# Personalized Travel Itinerary Planner — Environment Variables Template
#
# DO NOT add real credentials to this file.
# Copy this file to .env and configure your values:
#   cp .env.example .env
#
# SECURITY NOTICE:
#   The .env file is excluded from Git via .gitignore.
#   Never commit real API keys, database credentials, or secret tokens to Git.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 1. SERVER & RUNTIME ENVIRONMENT
# ─────────────────────────────────────────────────────────────────────────────
# Environment mode: 'development', 'staging', 'production', or 'test'
ENVIRONMENT=development

# Enable or disable debug mode (MUST be false in production)
DEBUG=false

# Backend API server URL
BACKEND_URL=http://localhost:8000

# Frontend application URL
FRONTEND_URL=http://localhost:5173

# Allowed CORS origins (comma-separated or JSON list)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────────────────────
# 2. SUPABASE DATABASE CONFIGURATION (BACKEND ONLY)
# ─────────────────────────────────────────────────────────────────────────────
# Supabase project URL from: Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase public anonymous key (read/write subject to Row Level Security)
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase administrative service-role key (bypasses RLS)
# WARNING: STRICTLY BACKEND ONLY. Never expose in frontend or repository.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─────────────────────────────────────────────────────────────────────────────
# 3. JWT AUTHENTICATION & SECURITY
# ─────────────────────────────────────────────────────────────────────────────
# Secret key for signing session tokens (must be at least 32 characters)
# Generate a new secure key via: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-random-32-plus-character-secret-key-here

# JWT cryptographic signing algorithm (default: HS256)
ALGORITHM=HS256

# JWT token validity lifetime in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─────────────────────────────────────────────────────────────────────────────
# 4. AI & LLM PROVIDERS
# ─────────────────────────────────────────────────────────────────────────────
# Active AI provider: 'gemini', 'groq', 'huggingface', 'ollama'
AI_PROVIDER=gemini
LLM_PROVIDER=gemini

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash

# Groq Cloud API
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Hugging Face Inference API
HUGGINGFACE_API_KEY=your-huggingface-token-here

# Local Ollama server (optional, for local offline inference)
OLLAMA_BASE_URL=http://localhost:11434

# ─────────────────────────────────────────────────────────────────────────────
# 5. OPTIONAL INFRASTRUCTURE
# ─────────────────────────────────────────────────────────────────────────────
# Redis URL for rate limiting or distributed cache
# REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────────────────────────────────────
# 6. FRONTEND (Vite Environment Variables)
# ─────────────────────────────────────────────────────────────────────────────
# Variables prefixed with VITE_ are bundled into client code by Vite.
# ONLY public variables (e.g. backend URL, anon key) may use VITE_ prefix.
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
